{
  "expo": {
    "name": "Fair Bengal Admin",
    "slug": "bhalobasha-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bhalobasha-admin",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fair Bengal অ্যাডমিন অ্যাপ বই বা পণ্যের ছবি আপলোড করতে আপনার গ্যালারিতে ঢুকতে চায়।"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairbengal.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fairbengal.admin",
      "adaptiveIcon": {
        "backgroundColor": "#1B3A5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d68a1967-2b6a-4707-b4c6-1f3e4e0afb34"
      }
    },
    "owner": "bhalobhashaadmin"
  }
}
