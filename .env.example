# Base URL of the bhalo-bhasha Next.js backend (the one at
# C:\Users\admin\Desktop\BhaloBhasha\bhalo-bhasha). Must be reachable from
# your phone/emulator — "localhost" only works from an iOS simulator, not
# from Expo Go on a physical device or an Android emulator.
#
# - Android emulator reaching a backend on your own machine: http://10.0.2.2:3000
# - Physical device on the same Wi-Fi as your machine:       http://<your-lan-ip>:3000
# - Deployed backend:                                        https://your-domain.example
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
